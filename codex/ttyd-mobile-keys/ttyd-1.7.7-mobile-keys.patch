--- a/html/src/style/index.scss
+++ b/html/src/style/index.scss
@@ -7,12 +7,70 @@ body {
 }

 #terminal-container {
+  display: flex;
+  flex-direction: column;
   width: auto;
   height: 100%;
   margin: 0 auto;
   padding: 0;
+  .terminal-viewport {
+    flex: 1 1 auto;
+    min-height: 0;
+    overflow: hidden;
+  }
   .terminal {
     padding: 5px;
     height: calc(100% - 10px);
   }
 }
+
+.mobile-keys {
+  display: none;
+}
+
+@media (hover: none), (pointer: coarse), (max-width: 768px) {
+  .terminal-viewport,
+  .terminal-viewport .xterm {
+    touch-action: none;
+    overscroll-behavior: contain;
+  }
+
+  .mobile-keys {
+    box-sizing: border-box;
+    display: grid;
+    flex: 0 0 auto;
+    grid-template-columns: repeat(7, minmax(0, 1fr));
+    grid-template-rows: repeat(2, 38px);
+    gap: 6px;
+    width: 100%;
+    overflow: hidden;
+    padding: 5px max(6px, env(safe-area-inset-right)) max(5px, env(safe-area-inset-bottom))
+      max(6px, env(safe-area-inset-left));
+    background: #181825;
+    border-top: 1px solid #45475a;
+  }
+
+  .mobile-key {
+    box-sizing: border-box;
+    width: 100%;
+    min-width: 0;
+    height: 38px;
+    margin: 0;
+    padding: 0 3px;
+    border: 1px solid #585b70;
+    border-radius: 7px;
+    color: #cdd6f4;
+    background: #313244;
+    font: 600 13px/1 Monaco, Consolas, monospace;
+    touch-action: manipulation;
+    user-select: none;
+    -webkit-tap-highlight-color: transparent;
+  }
+
+  .mobile-key:active,
+  .mobile-key.is-active {
+    color: #11111b;
+    background: #89dceb;
+    border-color: #89dceb;
+  }
+}
