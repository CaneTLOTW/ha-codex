diff --git a/html/src/components/terminal/xterm/index.ts b/html/src/components/terminal/xterm/index.ts
--- a/html/src/components/terminal/xterm/index.ts
+++ b/html/src/components/terminal/xterm/index.ts
@@ -123,6 +123,22 @@ export class Xterm {
     @bind
     public focus() {
         if (!window.matchMedia('(hover: none), (pointer: coarse), (max-width: 768px)').matches) {
             this.terminal?.focus();
         }
     }
+
+    @bind
+    public async pasteFromClipboard() {
+        if (!navigator.clipboard?.readText) {
+            this.overlayAddon?.showOverlay('Paste unavailable', 800);
+            return;
+        }
+
+        try {
+            const text = await navigator.clipboard.readText();
+            if (text) this.sendData(text);
+        } catch (e) {
+            console.warn('[ttyd] clipboard paste unavailable', e);
+            this.overlayAddon?.showOverlay('Paste unavailable', 800);
+        }
+    }
