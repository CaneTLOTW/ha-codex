#!/usr/bin/env bash
set -euo pipefail

font_size="$(jq -r '.terminal_font_size // 14' /data/options.json)"
case "$font_size" in
  *[!0-9]*|'') font_size=14 ;;
esac
if [[ "$font_size" -lt 10 || "$font_size" -gt 24 ]]; then
  font_size=14
fi

theme="$(jq -r '.terminal_theme // "dark"' /data/options.json)"
session_persist="$(jq -r '.session_persistence // false' /data/options.json)"
work_dir="$(jq -r '.working_directory // "/homeassistant"' /data/options.json)"
enable_mcp="$(jq -r '.enable_mcp' /data/options.json)"
default_model="$(jq -r '.default_model // ""' /data/options.json)"
codex_permissions="$(jq -r '.codex_permissions // "workspace"' /data/options.json)"
codex_approval_policy="$(jq -r '.codex_approval_policy // "on-request"' /data/options.json)"

export CODEX_STATE_ROOT="/data/codex-home"
export CODEX_MANAGED_ROOT="/data/codex-managed"
export CODEX_WORK_DIR="$work_dir"
export CODEX_SESSION_PERSIST="$session_persist"
export CODEX_ENABLE_MCP="$enable_mcp"
export CODEX_DEFAULT_MODEL="$default_model"
export CODEX_PERMISSIONS="$codex_permissions"
export CODEX_APPROVAL_POLICY="$codex_approval_policy"
export CODEX_HA_URL="http://supervisor/core"
export CODEX_SUPERVISOR_TOKEN_FILE="/tmp/codex/ha-token"
export CODEX_MCP_CONFIG="$CODEX_MANAGED_ROOT/mcp-servers.json"
export CODEX_MCP_ENVIRONMENT="$CODEX_MANAGED_ROOT/mcp-environment.json"

mkdir -p \
  "$CODEX_STATE_ROOT/users" \
  "$CODEX_MANAGED_ROOT" \
  /tmp/codex

chmod 700 /tmp/codex

/usr/local/bin/codex-prepare-mcp \
  /data/options.json \
  "$CODEX_MCP_CONFIG" \
  "$CODEX_MCP_ENVIRONMENT"
chown 0:0 "$CODEX_MCP_CONFIG"
chown 22000:0 "$CODEX_MCP_ENVIRONMENT"
chmod 644 "$CODEX_MCP_CONFIG"
chmod 600 "$CODEX_MCP_ENVIRONMENT"

if [[ -d /homeassistant/.codex-home && ! -d "$CODEX_STATE_ROOT/legacy-global-home" ]]; then
  cp -a /homeassistant/.codex-home "$CODEX_STATE_ROOT/legacy-global-home"
  echo "[INFO] Backed up legacy Codex state from /homeassistant/.codex-home to $CODEX_STATE_ROOT/legacy-global-home"
fi

grant_group_root_access() {
  local target="$1"
  if [[ ! -e "$target" ]]; then
    return
  fi

  if ! setfacl -R -m g:root:rwx "$target" 2>/dev/null; then
    chmod -R g+rwX "$target" 2>/dev/null || true
  fi

  if [[ -d "$target" ]]; then
    setfacl -R -d -m g:root:rwx "$target" 2>/dev/null || true
  fi
}

grant_group_root_access /homeassistant
grant_group_root_access /share
grant_group_root_access /media
grant_group_root_access "$work_dir"

printf '%s' "${SUPERVISOR_TOKEN:-}" > "$CODEX_SUPERVISOR_TOKEN_FILE"
chmod 600 "$CODEX_SUPERVISOR_TOKEN_FILE"
unset SUPERVISOR_TOKEN

echo "[INFO] Using image-installed Codex CLI: $(codex --version 2>/dev/null || echo unknown)"

cat > "$CODEX_MANAGED_ROOT/AGENTS.md" <<'EOF'
# Codex App for Home Assistant

## Path Mapping

In this App container, paths are mapped differently than HA Core:
- `/homeassistant` = HA config directory (equivalent to `/config` in HA Core)
- `/config` does NOT exist - always use `/homeassistant`

When users mention `/config/...`, translate to `/homeassistant/...`

## Available Paths

| Path | Description | Access |
|------|-------------|--------|
| `/homeassistant` | HA configuration | read-write |
| `/share` | Shared folder | read-write |
| `/media` | Media files | read-write |
| `/ssl` | SSL certificates | read-only |
| `/backup` | Backups | read-only |

## Codex Configuration

- The App manages Codex state under `/data/codex-home/users/anonymous/.codex` in direct-ttyd ingress mode.
- The terminal uses the shared Home Assistant ingress session identity unless ttyd provides a user id.
- This global `~/.codex/AGENTS.md` file is generated by the App.
- The App merges managed defaults into `~/.codex/config.toml` without removing unrelated user settings.
- Put project instructions in `/homeassistant/AGENTS.md` (or nested `AGENTS.md` files).
- Put project-specific config in `/homeassistant/.codex/config.toml`.
- Codex only loads project-specific config from trusted projects, so trust `/homeassistant` before relying on `/homeassistant/.codex/config.toml`.

## Home Assistant Integration

Use the `homeassistant` MCP server to query entities and call services when MCP is enabled. The Supervisor token stays outside the interactive shell and is only available through the privileged `hass-mcp` helper path.

Additional remote MCP servers configured in the App options are also managed in `~/.codex/config.toml`. Bearer-token values and explicitly configured environment variables are supplied to the Codex process environment instead of being written as plaintext values into `config.toml`.

## Bundled Runtime Tools

This App image includes a Home Assistant-oriented toolbox. Prefer these tools instead of assuming they need to be installed:

- Runtime/scripting: `python3` (with PyYAML), `bash`, `node`, `npm`
- Source control: `git`, `gh`
- Search/data: `jq`, `yq`, `yamllint`, `rg`, `grep`, `sed`, `gawk`, `find`, `sqlite3`
- Network/remote: `curl`, `openssl`, `ssh`, `scp`, `sftp`, `dig`, `nslookup`, `nc`, `mosquitto_pub`, `mosquitto_sub`, `rsync`
- Files/session: `file`, `tree`, `7z`, `zip`, `unzip`, `nano`, `vim`, `tmux`
- Home Assistant: the `homeassistant` MCP server and the authenticated read-only wrapper `ha-readonly`

For Home Assistant state/entity queries, prefer the `homeassistant` MCP tools. For Supervisor-backed Core diagnostics use only:

```bash
ha-readonly core info
ha-readonly core check
ha-readonly core logs
```

The raw `ha` binary is installed, but the Supervisor token is intentionally removed from the interactive Codex shell. A direct `ha core ...` call can therefore return `unauthorized`; this is expected and is not a missing-tool error. `ha-readonly` exposes only the three diagnostic commands above and does not reveal the token to Codex.

## Reading Home Assistant Logs

**Log levels (from most to least verbose):**
- `debug` - Only shown if explicitly enabled in configuration.yaml
- `info` - General information, shown by default
- `warning` - Warnings, always shown
- `error` - Errors, always shown

**Commands to read logs:**
```bash
ha-readonly core logs 2>&1 | tail -100
ha-readonly core logs 2>&1 | grep -i keyword
ha-readonly core logs 2>&1 | grep -iE "(error|exception)"
tail -100 /homeassistant/home-assistant.log
```
EOF

validate_home="$CODEX_MANAGED_ROOT/validate-home"
rm -rf "$validate_home"
mkdir -p "$validate_home"
trap 'rm -rf "$validate_home"' EXIT
/usr/local/bin/codex-merge-config \
  "${validate_home}/config.toml" \
  "$default_model" \
  "$enable_mcp" \
  "$codex_permissions" \
  "$codex_approval_policy" \
  "$CODEX_MCP_CONFIG"
if CODEX_HOME="$validate_home" codex debug prompt-input --help >/dev/null 2>&1; then
  CODEX_HOME="$validate_home" codex debug prompt-input "startup validation" >/dev/null
else
  echo "[WARN] Codex config parse validation unavailable in this CLI version"
fi
if [[ "$enable_mcp" == "true" ]]; then
  CODEX_HOME="$validate_home" codex mcp get homeassistant >/dev/null
  echo '[INFO] Bundled MCP server registered: "homeassistant" (voska/hass-mcp)'
else
  CODEX_HOME="$validate_home" codex mcp list >/dev/null
  echo '[INFO] Bundled MCP server disabled: "homeassistant"'
fi
rm -rf "$validate_home"
trap - EXIT

if [[ "$theme" == "dark" ]]; then
  colors='background=#1e1e2e,foreground=#cdd6f4,cursor=#f5e0dc'
else
  colors='background=#eff1f5,foreground=#4c4f69,cursor=#dc8a78'
fi

exec ttyd \
  --debug 3 \
  --port 7681 \
  --writable \
  --ping-interval 30 \
  --max-clients 5 \
  --index /usr/share/ttyd/mobile-index.html \
  -t "fontSize=${font_size}" \
  -t fontFamily=Monaco,Consolas,monospace \
  -t rendererType=canvas \
  -t scrollSensitivity=1 \
  -t fastScrollSensitivity=5 \
  -t scrollOnUserInput=true \
  -t smoothScrollDuration=0 \
  -t macOptionClickForcesSelection=true \
  -t scrollback=5000 \
  -t "theme=${colors}" \
  /usr/local/bin/codex-session
