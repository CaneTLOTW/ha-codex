#!/usr/bin/env bash
set -euo pipefail

font_size="$(jq -r '.terminal_font_size // 14' /data/options.json)"
case "$font_size" in
  *[!0-9]*|'') font_size=14 ;;
esac
if [[ "$font_size" -lt 10 || "$font_size" -gt 24 ]]; then
  font_size=14
fi

theme="$(jq -r '.terminal_theme // "dark"' /data/options.json)"
session_persist="$(jq -r '.session_persistence // false' /data/options.json)"
remote_control_enabled="$(jq -r '.remote_control_enabled // false' /data/options.json)"
file_transfer_enabled="$(jq -r '.file_transfer_enabled // false' /data/options.json)"
clipboard_image_paste="$(jq -r '.clipboard_image_paste // true' /data/options.json)"
direct_file_upload="$(jq -r '.direct_file_upload // true' /data/options.json)"
app_configs_visibility="$(jq -r '.app_configs_visibility // "hidden_from_guidance"' /data/options.json)"
work_dir="$(jq -r '.working_directory // "/homeassistant"' /data/options.json)"
enable_mcp="$(jq -r '.enable_mcp' /data/options.json)"
default_model="$(jq -r '.default_model // ""' /data/options.json)"
configured_codex_permissions="$(jq -r '.codex_permissions // "workspace"' /data/options.json)"
codex_approval_policy="$(jq -r '.codex_approval_policy // "on-request"' /data/options.json)"
addons_access="$(jq -r '.addons_access // "read_only"' /data/options.json)"

case "$remote_control_enabled" in
  true|false) ;;
  *)
    echo "[WARN] Invalid Remote Control flag; keeping it disabled." >&2
    remote_control_enabled="false"
    ;;
esac

case "$clipboard_image_paste" in
  true|false) ;;
  *) echo "[WARN] Invalid screenshot paste option; disabling." >&2; clipboard_image_paste=false ;;
esac

case "$direct_file_upload" in
  true|false) ;;
  *) echo "[WARN] Invalid direct file upload option; disabling." >&2; direct_file_upload=false ;;
esac

case "$file_transfer_enabled" in
  true|false) ;;
  *) echo "[WARN] Invalid file transfer option; disabling." >&2; file_transfer_enabled=false ;;
esac

case "$app_configs_visibility" in
  hidden_from_guidance|show_read_only) ;;
  *) echo "[WARN] Invalid app config visibility; hiding from agent guidance." >&2; app_configs_visibility=hidden_from_guidance ;;
esac

# The Developer image mounts /app_configs RO regardless of this preference.
# Hiding path guidance is NOT an access-control boundary; only installation of
# an image without the Supervisor mount actually revokes the privilege.
echo "[WARN] Developer public App config mount /app_configs is always RO mounted; app_configs_visibility only affects Codex guidance." >&2

case "$addons_access" in
  read_only|read_write) ;;
  *)
    echo "[WARN] Invalid addons_access value '$addons_access'; falling back to read_only." >&2
    addons_access="read_only"
    ;;
esac

# Resolve and validate the configured directory before either granting ACLs or
# handing it to the Codex session. This rejects aliases into read-only /addons
# and fails closed if the path cannot be resolved.
if ! work_dir="$(python3 /usr/local/bin/codex-addons-sandbox --resolve-working-directory "$work_dir" "$addons_access")"; then
  echo "[WARN] Invalid or disallowed working directory; falling back to /homeassistant." >&2
  if ! work_dir="$(python3 /usr/local/bin/codex-addons-sandbox --resolve-working-directory /homeassistant "$addons_access")"; then
    echo "[ERROR] /homeassistant is not a valid working directory for the configured /addons access mode." >&2
    exit 1
  fi
fi

codex_permissions="$configured_codex_permissions"
if [[ "$addons_access" == "read_only" && "$codex_permissions" == "full_access" ]]; then
  codex_permissions="workspace"
  echo "[WARN] /addons is configured read-only; effective Codex access is reduced from full_access to workspace so /addons can remain outside writable roots." >&2
fi

case "$work_dir" in
  /addons|/addons/*)
    if [[ "$addons_access" == "read_only" ]]; then
      echo "[WARN] Working directory '$work_dir' is below read-only /addons; falling back to /homeassistant." >&2
      work_dir="/homeassistant"
    fi
    ;;
esac

export CODEX_STATE_ROOT="/data/codex-home"
export CODEX_MANAGED_ROOT="/data/codex-managed"
export CODEX_WORK_DIR="$work_dir"
export CODEX_SESSION_PERSIST="$session_persist"
export CODEX_FILE_TRANSFER_ENABLED="$file_transfer_enabled"
# The custom WS command is refused server-side unless this environment flag
# is true, independent of the browser's client preference.
export CODEX_IMAGE_PASTE_ENABLED="$clipboard_image_paste"
export CODEX_FILE_UPLOAD_ENABLED="$direct_file_upload"
export CODEX_APP_CONFIGS_VISIBILITY="$app_configs_visibility"
export CODEX_ENABLE_MCP="$enable_mcp"
export CODEX_DEFAULT_MODEL="$default_model"
export CODEX_PERMISSIONS="$codex_permissions"
export CODEX_APPROVAL_POLICY="$codex_approval_policy"
export CODEX_ADDONS_ACCESS="$addons_access"
export CODEX_HA_URL="http://supervisor/core"
export CODEX_SUPERVISOR_TOKEN_FILE="/tmp/codex/ha-token"
export CODEX_MCP_CONFIG="$CODEX_MANAGED_ROOT/mcp-servers.json"
export CODEX_MCP_ENVIRONMENT="$CODEX_MANAGED_ROOT/mcp-environment.json"

mkdir -p \
  "$CODEX_STATE_ROOT/users" \
  "$CODEX_MANAGED_ROOT" \
  /tmp/codex

# Clipboard screenshots are written by the authenticated ttyd WS handler,
# with randomized 0600 names, and read as images by the unprivileged CLI.
image_upload_dir="$CODEX_STATE_ROOT/users/anonymous/.codex/uploads"
if [[ -L "$image_upload_dir" ]]; then
  echo "[ERROR] Refusing a symlinked clipboard image directory." >&2
  exit 1
fi
mkdir -p "$image_upload_dir"
chown 22000:0 "$image_upload_dir"
chmod 700 "$image_upload_dir"

chmod 700 /tmp/codex
printf '%s\n' "$addons_access" > "$CODEX_MANAGED_ROOT/addons-access"
chmod 644 "$CODEX_MANAGED_ROOT/addons-access"

/usr/local/bin/codex-prepare-mcp \
  /data/options.json \
  "$CODEX_MCP_CONFIG" \
  "$CODEX_MCP_ENVIRONMENT"
chown 0:0 "$CODEX_MCP_CONFIG"
chown 22000:0 "$CODEX_MCP_ENVIRONMENT"
chmod 644 "$CODEX_MCP_CONFIG"
chmod 600 "$CODEX_MCP_ENVIRONMENT"

if [[ -d /homeassistant/.codex-home && ! -d "$CODEX_STATE_ROOT/legacy-global-home" ]]; then
  cp -a /homeassistant/.codex-home "$CODEX_STATE_ROOT/legacy-global-home"
  echo "[INFO] Backed up legacy Codex state from /homeassistant/.codex-home to $CODEX_STATE_ROOT/legacy-global-home"
fi

grant_group_root_access() {
  # Restrict both ACL and chmod operations to eligible workspace paths.
  # The helper prunes .ssh and private keys and does not install inherited ACLs.
  bash /usr/local/bin/codex-grant-access "$1"
}

grant_group_root_access /homeassistant
grant_group_root_access /share
grant_group_root_access /media
if [[ "$addons_access" == "read_write" ]]; then
  grant_group_root_access /addons
fi
# The working directory may be on the image or in private app data.
# Only the explicitly mounted workspaces above receive permission grants.

printf '%s' "${SUPERVISOR_TOKEN:-}" > "$CODEX_SUPERVISOR_TOKEN_FILE"
chmod 600 "$CODEX_SUPERVISOR_TOKEN_FILE"
unset SUPERVISOR_TOKEN

echo "[INFO] Using image-installed Codex CLI: $(codex --version 2>/dev/null || echo unknown)"
echo "[INFO] /addons access: ${addons_access}; effective Codex access: ${codex_permissions}"

cat > "$CODEX_MANAGED_ROOT/AGENTS.md" <<'EOF_AGENTS'
# Codex App for Home Assistant

## Path Mapping

In this App container, paths are mapped differently than HA Core:
- `/homeassistant` = HA config directory (equivalent to `/config` in HA Core)
- `/config` does NOT exist - always use `/homeassistant`

When users mention `/config/...`, translate to `/homeassistant/...`

## Available Paths

| Path | Description | Access |
|------|-------------|--------|
| `/homeassistant` | HA configuration | read-write |
| `/share` | Shared folder | read-write |
| `/media` | Media files | read-write |
| `/ssl` | SSL certificates | read-only |
| `/backup` | Backups | read-only |
| `/addons` | Local Home Assistant App sources | controlled by `addons_access` |

## `/addons` access

Home Assistant App mount permissions are static, so `/addons` is mounted into this container with host-level read-write capability. The `addons_access` App option is enforced at the Codex runtime layer:

- `read_only` keeps `/addons` out of Codex writable roots. If `full_access` was configured, the effective Codex mode is reduced to `workspace` because `danger-full-access` cannot exclude one path.
- `read_write` grants the unprivileged Codex runtime user filesystem access and, in workspace mode, adds `/addons` to Codex writable roots.

A manual diagnostic shell opened after Codex exits is not a Codex sandbox boundary; use the Home Assistant App option and Codex session for controlled project work.

## Codex Configuration

- The App manages Codex state under `/data/codex-home/users/anonymous/.codex` in direct-ttyd ingress mode.
- The terminal uses the shared Home Assistant ingress session identity unless ttyd provides a user id.
- This global `~/.codex/AGENTS.md` file is generated by the App.
- The App merges managed defaults into `~/.codex/config.toml` without removing unrelated user settings.
- Put project instructions in `/homeassistant/AGENTS.md` (or nested `AGENTS.md` files).
- Put project-specific config in `/homeassistant/.codex/config.toml`.
- Codex only loads project-specific config from trusted projects, so trust `/homeassistant` before relying on `/homeassistant/.codex/config.toml`.

## Home Assistant Integration

Use the `homeassistant` MCP server to query entities and call services when MCP is enabled. The Supervisor token stays outside the interactive shell and is only available through the privileged `hass-mcp` helper path.

For Lovelace custom-card resources, use the separate `ha_lovelace_resources` MCP server. It exposes only resource list, hash-validated `/local/` upsert, delete and targeted rollback operations. Never edit `.storage/lovelace_resources` directly; keep `/local/community/` and `/hacsfiles/` resources untouched. See `codex/docs/LOVELACE_RESOURCE_DEPLOYMENTS.md` in the repository for the required backup/readback workflow.

Additional remote MCP servers configured in the App options are also managed in `~/.codex/config.toml`. Bearer-token values and explicitly configured environment variables are supplied to the Codex process environment instead of being written as plaintext values into `config.toml`.

## Bundled Runtime Tools

This App image includes a Home Assistant-oriented toolbox. Prefer these tools instead of assuming they need to be installed:

- Runtime/scripting: `python3` (with PyYAML), `bash`, `node`, `npm`
- Source control: `git`, `gh`
- Search/data: `jq`, `yq`, `yamllint`, `rg`, `grep`, `sed`, `gawk`, `find`, `sqlite3`
- Network/remote: `curl`, `openssl`, `ssh`, `scp`, `sftp`, `dig`, `nslookup`, `nc`, `mosquitto_pub`, `mosquitto_sub`, `rsync`
- Files/session: `file`, `tree`, `7z`, `zip`, `unzip`, `nano`, `vim`, `tmux`
- Home Assistant: the `homeassistant` MCP server and the authenticated read-only wrapper `ha-readonly`

For Home Assistant state/entity queries, prefer the `homeassistant` MCP tools. For Supervisor-backed Core diagnostics use only:

```bash
ha-readonly core info
ha-readonly core check
ha-readonly core logs
```

The raw `ha` binary is installed, but the Supervisor token is intentionally removed from the interactive Codex shell. A direct `ha core ...` call can therefore return `unauthorized`; this is expected and is not a missing-tool error. `ha-readonly` exposes only the three diagnostic commands above and does not reveal the token to Codex.

## Reading Home Assistant Logs

**Log levels (from most to least verbose):**
- `debug` - Only shown if explicitly enabled in configuration.yaml
- `info` - General information, shown by default
- `warning` - Warnings, always shown
- `error` - Errors, always shown

**Commands to read logs:**
```bash
ha-readonly core logs 2>&1 | tail -100
ha-readonly core logs 2>&1 | grep -i keyword
ha-readonly core logs 2>&1 | grep -iE "(error|exception)"
tail -100 /homeassistant/home-assistant.log
```
EOF_AGENTS

# A read-only bind mount is always installed in this Developer image. The
# preference below controls instructions only, never filesystem privileges.
if [[ "$app_configs_visibility" == "show_read_only" ]]; then
  cat >> "$CODEX_MANAGED_ROOT/AGENTS.md" <<'EOF_APP_CONFIGS'
## Other Home Assistant App public configuration

The Supervisor maps /app_configs read-only. It contains *public* App config folders
(not private /data of each App, and not Unraid Docker appdata). Some files may
contain credentials: never include secrets in logs, answers, or GitHub.
The App option app_configs_visibility controls documentation visibility only;
changing it does not remove the Supervisor mount.
EOF_APP_CONFIGS
fi

if [[ "$file_transfer_enabled" == "true" ]]; then
  cat >> "$CODEX_MANAGED_ROOT/AGENTS.md" <<'EOF_UPLOADS'
## Experimental uploads

From the interactive shell (Ctrl+C to exit Codex), run codex-upload for files,
or codex-upload --directory for folders. Use the browser file chooser.
Uploads are stored under the current CODEX_HOME/uploads directory, not /homeassistant.
After returning to Codex, refer to the exact uploaded pathname so the
agent can inspect it. Image clipboard Ctrl+V is NOT implemented yet.
Use HTTPS when testing browser file pickers on non-localhost origins.
EOF_UPLOADS
fi

if [[ "$clipboard_image_paste" == "true" ]]; then
  cat >> "$CODEX_MANAGED_ROOT/AGENTS.md" <<'EOF_CLIPBOARD'
## Screenshot clipboard paste (experimental)

In the currently running Codex TUI, copy a PNG screenshot on your computer
and paste with Ctrl+V in the Home Assistant terminal. The authenticated
ttyd WebSocket transfers the PNG into private state beneath
/data/codex-home/users/anonymous/.codex/uploads, then sends its pathname
as a bracketed paste to Codex's own existing image-attachment handler.
Never store or print image contents in logs. The model needs image support.
Normal text paste is unchanged; other files still use codex-upload in shell.
EOF_CLIPBOARD
fi

validate_home="$CODEX_MANAGED_ROOT/validate-home"
rm -rf "$validate_home"
mkdir -p "$validate_home"
trap 'rm -rf "$validate_home"' EXIT
/usr/local/bin/codex-merge-config \
  "${validate_home}/config.toml" \
  "$default_model" \
  "$enable_mcp" \
  "$codex_permissions" \
  "$codex_approval_policy" \
  "$CODEX_MCP_CONFIG"
if CODEX_HOME="$validate_home" codex debug prompt-input --help >/dev/null 2>&1; then
  CODEX_HOME="$validate_home" codex debug prompt-input "startup validation" >/dev/null
else
  echo "[WARN] Codex config parse validation unavailable in this CLI version"
fi
if [[ "$enable_mcp" == "true" ]]; then
  CODEX_HOME="$validate_home" codex mcp get homeassistant >/dev/null
  echo '[INFO] Bundled MCP server registered: "homeassistant" (voska/hass-mcp)'
  CODEX_HOME="$validate_home" codex mcp get ha_lovelace_resources >/dev/null
  echo '[INFO] Bundled least-privilege MCP server registered: "ha_lovelace_resources"'
else
  CODEX_HOME="$validate_home" codex mcp list >/dev/null
  echo '[INFO] Bundled MCP server disabled: "homeassistant"'
fi
rm -rf "$validate_home"
trap - EXIT

if [[ "$theme" == "dark" ]]; then
  colors='background=#1e1e2e,foreground=#cdd6f4,cursor=#f5e0dc'
else
  colors='background=#eff1f5,foreground=#4c4f69,cursor=#dc8a78'
fi

ttyd_args=(
  --debug 3
  --port 7681
  --writable
  --ping-interval 30
  --max-clients 5
  --index /usr/share/ttyd/mobile-index.html
  -t "fontSize=${font_size}"
  -t fontFamily=Monaco,Consolas,monospace
  -t rendererType=canvas
  -t scrollSensitivity=1
  -t fastScrollSensitivity=5
  -t scrollOnUserInput=true
  -t smoothScrollDuration=0
  -t macOptionClickForcesSelection=true
  -t scrollback=5000
  -t "enableTrzsz=${file_transfer_enabled}"
  -t "enableCodexImagePaste=${clipboard_image_paste}"
  -t "enableCodexFileUpload=${direct_file_upload}"
  -t "theme=${colors}"
  /usr/local/bin/codex-session
)

# Keep the existing ttyd-as-main-process behavior while disabled.
if [[ "$remote_control_enabled" != "true" ]]; then
  exec ttyd "${ttyd_args[@]}"
fi

# With Remote Control enabled, supervise both processes. ttyd controls the
# App lifetime; the optional remote-control sidecar can fail independently.
/usr/local/bin/codex-remote-control &
remote_control_pid=$!
ttyd "${ttyd_args[@]}" &
ttyd_pid=$!

stop_children() {
  trap - TERM INT HUP
  kill -TERM "$remote_control_pid" "$ttyd_pid" 2>/dev/null || true
  wait "$remote_control_pid" 2>/dev/null || true
  wait "$ttyd_pid" 2>/dev/null || true
}
trap 'stop_children; exit 143' TERM INT HUP
ttyd_status=0
wait "$ttyd_pid" || ttyd_status=$?
stop_children
exit "$ttyd_status"
