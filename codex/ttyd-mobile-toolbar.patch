diff --git a/html/src/components/terminal/index.tsx b/html/src/components/terminal/index.tsx
--- a/html/src/components/terminal/index.tsx
+++ b/html/src/components/terminal/index.tsx
@@ -35,11 +35,23 @@ export class Terminal extends Component<Props, State> {
     render({ id }: Props, { modal }: State) {
+        const isTouchDevice =
+            typeof navigator !== 'undefined' &&
+            (navigator.maxTouchPoints > 0 || window.matchMedia('(pointer: coarse)').matches);
+        const shellClass = isTouchDevice ? 'terminal-shell touch-device' : 'terminal-shell';
         return (
-            <div id={id} ref={c => (this.container = c as HTMLElement)}>
+            <div class={shellClass}>
+                <div class="terminal-toolbar" role="toolbar" aria-label="Terminal tools">
+                    <button type="button" onClick={() => this.xterm.scrollLines(-12)} aria-label="Scroll up">▲</button>
+                    <button type="button" onClick={() => this.xterm.scrollLines(12)} aria-label="Scroll down">▼</button>
+                    <button type="button" onClick={this.xterm.copySelectionFromToolbar} aria-label="Copy selection">Copy</button>
+                    <button type="button" onClick={this.xterm.pasteFromClipboard} aria-label="Paste clipboard">Paste</button>
+                </div>
+                <div id={id} ref={c => (this.container = c as HTMLElement)}>
                 <Modal show={modal}>
                     <label class="file-label">
                         <input onChange={this.sendFile} class="file-input" type="file" multiple />
                         <span class="file-cta">Choose files…</span>
                     </label>
                 </Modal>
+                </div>
             </div>
         );
diff --git a/html/src/style/index.scss b/html/src/style/index.scss
--- a/html/src/style/index.scss
+++ b/html/src/style/index.scss
@@ -18,0 +19,43 @@
+.terminal-shell {
+  width: 100%;
+  max-width: 100vw;
+  height: 100%;
+  overflow: hidden;
+  box-sizing: border-box;
+}
+
+.terminal-toolbar {
+  display: none;
+  width: 100%;
+  max-width: 100vw;
+  height: 44px;
+  box-sizing: border-box;
+  overflow: hidden;
+  gap: 4px;
+  padding: 4px max(4px, env(safe-area-inset-right)) 4px max(4px, env(safe-area-inset-left));
+  background: #2b2b2b;
+}
+
+.terminal-toolbar button {
+  flex: 1 1 0;
+  min-width: 0;
+  border: 1px solid #666;
+  border-radius: 4px;
+  background: #3b3b3b;
+  color: #fff;
+  font: inherit;
+  overflow: hidden;
+  white-space: nowrap;
+}
+
+.terminal-toolbar button:active {
+  background: #555;
+}
+
+.terminal-shell.touch-device .terminal-toolbar {
+  display: flex;
+}
+
+.terminal-shell.touch-device #terminal-container {
+  height: calc(100% - 44px);
+}
